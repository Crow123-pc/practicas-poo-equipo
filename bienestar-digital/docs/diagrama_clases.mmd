class Participante {
  <<record>>
  -String codigo
  -String nombre
  -int edad
  -String grado
}
class Taller {
  <<record>>
  -String codigo
  -String titulo
  -LocalDate fecha
  -int minutos
  -int cupo
  -String expositor
}
class Historial {
  <<record>>
  -Taller taller
  -Asistencia asistencia
  -Integer nota
}
class ResumenAsistencia {
  <<record>>
  -int presentes
  -int ausentes
  -int pendientes
}
class Inscripcion {
  <<record>>
  -String taller
  -String participante
  -Asistencia asistencia
  -Integer nota
}
class Asistencia {
  <<enumeration>>
  PENDIENTE
  PRESENTE
  AUSENTE
}
class ArchivoCsv {
  +linea(String...) String
  +separar(String) List
  +leer(Path) List
  +guardar(Path, List)
}
class Validador {
  ~texto(String, String, int) String
  ~codigo(String) String
}
